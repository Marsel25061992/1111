<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Дашборд освоения бюджета</title>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chartjs-plugin-datalabels@2"></script>
    <script src="https://cdn.sheetjs.com/xlsx-latest/package/dist/xlsx.full.min.js"></script>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body { font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; background: #0f1419; color: #e0e0e0; padding: 20px; min-height: 100vh; }
        .dashboard { max-width: 1800px; margin: 0 auto; }
        .tabs { display: flex; gap: 4px; margin-bottom: 20px; flex-wrap: wrap; }
        .tab { padding: 12px 24px; background: #1e2a3a; color: #a0aec0; border: 1px solid #2d3748; border-radius: 6px; cursor: pointer; font-size: 14px; transition: all 0.3s; }
        .tab:hover { background: #2d3748; color: #e0e0e0; }
        .tab.active { background: rgb(0, 180, 115); color: #0f1419; border-color: rgb(0, 180, 115); font-weight: 600; }
        .upload-section { background: #1e2a3a; border: 2px dashed rgb(0, 180, 115); border-radius: 8px; padding: 40px; text-align: center; margin-bottom: 20px; }
        .upload-section h2 { color: rgb(0, 180, 115); margin-bottom: 20px; font-size: 18px; }
        .file-input-wrapper { position: relative; display: inline-block; margin: 10px; }
        .file-input-wrapper input[type=file] { position: absolute; left: 0; top: 0; opacity: 0; cursor: pointer; width: 100%; height: 100%; }
        .file-input-button { display: inline-block; padding: 14px 32px; background: rgb(0, 180, 115); color: #0f1419; border-radius: 6px; cursor: pointer; font-weight: 600; font-size: 15px; transition: all 0.3s; }
        .file-input-button:hover { background: rgb(0, 200, 130); }
        .file-name { margin-top: 15px; font-size: 14px; color: #a0aec0; }
        .error-message { color: rgb(240, 60, 70); margin-top: 10px; font-size: 14px; background: rgba(240, 60, 70, 0.1); padding: 10px; border-radius: 4px; }
        .success-message { color: rgb(0, 180, 115); margin-top: 10px; font-size: 14px; }
        .dashboard-content { display: none; }
        .filter-section { background: #1e2a3a; border: 1px solid #2d3748; border-radius: 8px; padding: 20px; margin-bottom: 20px; }
        .filter-title { font-size: 14px; color: #a0aec0; margin-bottom: 12px; display: flex; align-items: center; gap: 8px; }
        .month-buttons { display: flex; gap: 8px; flex-wrap: wrap; margin-bottom: 10px; }
        .month-btn { padding: 8px 16px; background: #2d3748; color: #e0e0e0; border: 1px solid #4a5568; border-radius: 6px; cursor: pointer; font-size: 13px; transition: all 0.2s; }
        .month-btn:hover { background: #4a5568; }
        .month-btn.active { background: rgb(0, 180, 115); color: #0f1419; border-color: rgb(0, 180, 115); font-weight: 600; }
        .filter-status { font-size: 12px; color: #718096; }
        .filter-status span { color: rgb(0, 180, 115); font-weight: 600; }
        .dashboard-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-bottom: 20px; }
        .card { background: #1e2a3a; border: 1px solid #2d3748; border-radius: 8px; padding: 24px; }
        .card-title { font-size: 16px; font-weight: 600; color: rgb(0, 180, 115); margin-bottom: 20px; }
        .donut-wrapper { position: relative; max-width: 600px; margin: 0 auto; height: 500px; display: flex; align-items: center; justify-content: center; }
        .donut-wrapper canvas { max-width: 100%; max-height: 100%; }
        .donut-center { position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); font-size: 42px; font-weight: bold; color: rgb(0, 180, 115); z-index: 10; pointer-events: none; }
        .legend { display: flex; justify-content: center; gap: 24px; margin-top: 20px; font-size: 13px; }
        .legend-item { display: flex; align-items: center; gap: 8px; color: #a0aec0; }
        .legend-color { width: 16px; height: 16px; border-radius: 3px; }
        .method-chart-wrapper { height: 500px; }
        .monthly-chart-wrapper { height: 550px; }
        .table-container { overflow-x: auto; max-height: 550px; overflow-y: auto; }
        table { width: 100%; border-collapse: collapse; font-size: 14px; }
        th { padding: 14px 16px; text-align: center; font-weight: 600; background: #2d3748; color: #e0e0e0; border-bottom: 2px solid #4a5568; position: sticky; top: 0; font-size: 14px; }
        td { padding: 14px 16px; border-bottom: 1px solid #2d3748; color: #e0e0e0; font-size: 14px; }
        td:first-child { text-align: left; }
        td:not(:first-child) { text-align: right; }
        tr:nth-child(even) { background: #1a2332; }
        tr:hover { background: #2d3748; }
        .no-data { text-align: center; padding: 40px; color: #718096; font-size: 14px; }
        .table-wrapper { overflow-x: auto; max-height: 700px; overflow-y: auto; border-radius: 6px; }
        .department-table, .details-table { width: 100%; border-collapse: separate; border-spacing: 0; font-size: 13px; background: #1e2a3a; }
        .department-table th, .department-table td, .details-table th, .details-table td { border: 1px solid #2d3748; padding: 10px 12px; text-align: right; white-space: nowrap; }
        .department-table th, .details-table th { background: #2d3748; color: #e0e0e0; font-weight: 600; position: sticky; top: 0; z-index: 10; }
        .department-table th:first-child, .department-table td:first-child, .details-table th:first-child, .details-table td:first-child { text-align: left; position: sticky; left: 0; background: #1e2a3a; z-index: 2; border-right: 2px solid #4a5568; min-width: 250px; }
        .department-table th:first-child, .details-table th:first-child { z-index: 12; }
        .department-table tr:nth-child(even), .details-table tr:nth-child(even) { background: #1a2332; }
        .department-table tr:nth-child(odd), .details-table tr:nth-child(odd) { background: #1e2a3a; }
        .department-table tr:hover, .details-table tr:hover { background: #2d3748; }
        .department-table tr:last-child, .details-table tr.grand-total { font-weight: bold; background: #2d3748 !important; }
        .department-table tr:last-child td:first-child, .details-table tr.grand-total td:first-child { background: #2d3748 !important; }
        .highlight-red { background-color: #FFC7CE !important; color: #9C0006 !important; font-weight: bold; }
        .legend-box { margin-top: 15px; padding: 10px; background: rgba(255, 199, 206, 0.1); border-radius: 4px; font-size: 12px; color: #e0e0e0; }
        .legend-box span { color: #9C0006; font-weight: bold; }
        .export-button { display: inline-block; padding: 10px 20px; background: rgb(0, 180, 115); color: #0f1419; border: none; border-radius: 6px; cursor: pointer; font-weight: 600; font-size: 14px; margin-top: 15px; transition: all 0.3s; }
        .export-button:hover { background: rgb(0, 200, 130); }
        .loading { display: none; text-align: center; padding: 20px; }
        .spinner { border: 3px solid #2d3748; border-top: 3px solid rgb(0, 180, 115); border-radius: 50%; width: 40px; height: 40px; animation: spin 1s linear infinite; margin: 0 auto 10px; }
        @keyframes spin { 0% { transform: rotate(0deg); } 100% { transform: rotate(360deg); } }
        .tab-content { display: none; }
        .tab-content.active { display: block; }
        .info-bar { margin-bottom: 15px; padding: 10px 15px; background: rgba(0, 180, 115, 0.1); border-left: 3px solid rgb(0, 180, 115); border-radius: 4px; font-size: 13px; color: rgb(0, 180, 115); }
        .section-header { background: linear-gradient(135deg, #ffd700 0%, #ffcc00 100%) !important; color: #0f1419 !important; font-weight: bold; font-size: 13px; }
        .section-header td { background: linear-gradient(135deg, #ffd700 0%, #ffcc00 100%) !important; color: #0f1419 !important; border: 1px solid #cc9900; text-align: left; padding: 10px 12px; }
        .section-header td:first-child { background: linear-gradient(135deg, #ffd700 0%, #ffcc00 100%) !important; }
        .section-total { background: #1a2332 !important; font-weight: bold; border-top: 2px solid #4a5568; color: rgb(0, 180, 115); }
        .section-total td:first-child { background: #1a2332 !important; }
        .zebra-even { background: #1e2a3a; }
        .zebra-odd { background: #1a2332; }
        .section-summary { float: right; font-size: 11px; color: #0f1419; font-weight: 600; }
        .forecast-overrun { background-color: rgba(240, 60, 70, 0.15) !important; color: #f03c46 !important; font-weight: bold; }
        .forecast-safe { color: rgb(0, 180, 115); }
        .forecast-partial { background-color: rgba(96, 165, 250, 0.15) !important; color: #60a5fa !important; font-weight: bold; }
        #forecastMonthSelector { margin-top: 10px; }
        @media (max-width: 768px) {
            .dashboard-grid { grid-template-columns: 1fr; }
            .month-buttons { justify-content: center; }
            .month-btn { padding: 6px 12px; font-size: 12px; }
        }
    </style>
</head>
<body>
    <div class="dashboard">
        <div class="upload-section" id="uploadSection">
            <h2>Загрузка данных из Excel файла</h2>
            <div class="file-input-wrapper">
                <div class="file-input-button">📁 Выберите файл Excel</div>
                <input type="file" id="fileInput" accept=".xlsx,.xls" />
            </div>
            <div id="fileName" class="file-name"></div>
            <div id="message"></div>
        </div>

        <div id="dashboardContent" class="dashboard-content">
            <div class="tabs">
