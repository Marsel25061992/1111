        function determinePeriods(minDate, maxDate) {
            const periods = [];
            const presentMonths = new Set();
            rawData.forEach(d => presentMonths.add(`${d.year}-${d.month}`));
            const startYear = minDate.getFullYear(), endYear = maxDate.getFullYear();
            const startMonth = minDate.getMonth() + 1, endMonth = maxDate.getMonth() + 1;
            for (let year = startYear; year <= endYear; year++) {
                const startQ = year === startYear ? Math.ceil(startMonth / 3) : 1;
                const endQ = year === endYear ? Math.ceil(endMonth / 3) : 4;
                for (let q = startQ; q <= endQ; q++) {
                    const monthStart = (q - 1) * 3 + 1, monthEnd = monthStart + 2;
                    const presentInQuarter = [];
                    for (let m = monthStart; m <= monthEnd; m++) if (presentMonths.has(`${year}-${m}`)) presentInQuarter.push(m);
                    if (presentInQuarter.length === 3) periods.push({ type: 'quarter', name: `${q} квартал`, year: year, months: presentInQuarter });
                    else presentInQuarter.forEach(m => periods.push({ type: 'month', name: monthNamesFull[m - 1], year: year, month: m }));
                }
            }
            const totalMonths = rawData.length > 0 ? (maxDate.getFullYear() - minDate.getFullYear()) * 12 + (maxDate.getMonth() - minDate.getMonth()) + 1 : 0;
            const monthWord = totalMonths === 1 ? 'месяц' : (totalMonths >= 2 && totalMonths <= 4) ? 'месяца' : 'месяцев';
            periods.push({ type: 'total', name: `Итого за ${totalMonths} ${monthWord}`, totalMonths: totalMonths });
            return periods;
        }

        function aggregateDepartmentData(periods) {
            const customers = new Map();
            rawData.forEach(d => {
                if (!customers.has(d.customer)) customers.set(d.customer, { name: d.customer, periods: {}, totalPlan: 0, totalFact: 0 });
                const cust = customers.get(d.customer);
                let periodKey = null;
                for (let i = 0; i < periods.length - 1; i++) {
                    const p = periods[i];
                    if (p.type === 'quarter' && p.months.includes(d.month) && p.year === d.year) { periodKey = `${p.year}_Q${p.months[0]}`; break; }
                    else if (p.type === 'month' && p.month === d.month && p.year === d.year) { periodKey = `${p.year}_M${p.month}`; break; }
                }
                if (periodKey) {
                    if (!cust.periods[periodKey]) cust.periods[periodKey] = { plan: 0, fact: 0 };
                    if (d.criteria === 'План') { cust.periods[periodKey].plan += d.costs; cust.totalPlan += d.costs; }
                    else { cust.periods[periodKey].fact += d.costs; cust.totalFact += d.costs; }
                }
            });
            return Array.from(customers.values());
        }

        function renderDepartmentTable(periods, customers) {
            const table = document.getElementById('departmentTable');
            const thead = table.querySelector('thead');
            const tbody = table.querySelector('tbody');
            let headerHTML = '<tr><th rowspan="2">Заказчик</th>';
            periods.slice(0, -1).forEach(p => headerHTML += `<th colspan="2">${p.name}</th>`);
            headerHTML += `<th colspan="2">${periods[periods.length - 1].name}</th><th rowspan="2">Отклонение</th></tr><tr>`;
            periods.slice(0, -1).forEach(() => headerHTML += '<th>План</th><th>Факт</th>');
            headerHTML += '<th>План</th><th>Факт</th></tr>';
            thead.innerHTML = headerHTML;
            let totalPlan = 0, totalFact = 0;
            customers.forEach(cust => {
                let rowHTML = `<td>${cust.name}</td>`;
                periods.slice(0, -1).forEach(p => {
                    let periodKey = p.type === 'quarter' ? `${p.year}_Q${p.months[0]}` : `${p.year}_M${p.month}`;
                    const data = cust.periods[periodKey] || { plan: 0, fact: 0 };
                    const planClass = data.fact > data.plan ? 'highlight-red' : '';
                    rowHTML += `<td>${formatNumber(data.plan / 1000)}</td><td class="${planClass}">${formatNumber(data.fact / 1000)}</td>`;
                });
                rowHTML += `<td>${formatNumber(cust.totalPlan / 1000)}</td><td>${formatNumber(cust.totalFact / 1000)}</td>`;
                const deviation = cust.totalPlan - cust.totalFact;
                rowHTML += `<td class="${deviation < 0 ? 'highlight-red' : ''}">${formatNumber(deviation / 1000)}</td>`;
                tbody.innerHTML += `<tr>${rowHTML}</tr>`;
                totalPlan += cust.totalPlan; totalFact += cust.totalFact;
            });
            const totalDeviation = totalPlan - totalFact;
            let totalRowHTML = '<tr><td>Итого по договору</td>';
            periods.slice(0, -1).forEach(() => totalRowHTML += '<td>-</td><td>-</td>');
            totalRowHTML += `<td>${formatNumber(totalPlan / 1000)}</td><td>${formatNumber(totalFact / 1000)}</td><td class="${totalDeviation < 0 ? 'highlight-red' : ''}">${formatNumber(totalDeviation / 1000)}</td></tr>`;
            tbody.innerHTML += totalRowHTML;
        }

        function aggregateDetailsData(periods) {
            const methods = new Map();
            rawData.forEach(d => {
                if (!methods.has(d.method)) methods.set(d.method, { name: d.method, customers: new Map(), totalPlan: 0, totalFact: 0 });
                const method = methods.get(d.method);
                if (!method.customers.has(d.customer)) method.customers.set(d.customer, { name: d.customer, periods: {}, totalPlan: 0, totalFact: 0 });
                const customer = method.customers.get(d.customer);
                let periodKey = null;
                for (let i = 0; i < periods.length - 1; i++) {
                    const p = periods[i];
                    if (p.type === 'quarter' && p.months.includes(d.month) && p.year === d.year) { periodKey = `${p.year}_Q${p.months[0]}`; break; }
                    else if (p.type === 'month' && p.month === d.month && p.year === d.year) { periodKey = `${p.year}_M${p.month}`; break; }
                }
                if (periodKey) {
                    if (!customer.periods[periodKey]) customer.periods[periodKey] = { plan: 0, fact: 0 };
                    if (d.criteria === 'План') { customer.periods[periodKey].plan += d.costs; customer.totalPlan += d.costs; method.totalPlan += d.costs; }
                    else { customer.periods[periodKey].fact += d.costs; customer.totalFact += d.costs; method.totalFact += d.costs; }
                }
            });
            return Array.from(methods.values());
        }

        function renderDetailsTable(periods, methods) {
            const table = document.getElementById('detailsTable');
            const thead = table.querySelector('thead');
            const tbody = table.querySelector('tbody');
            tbody.innerHTML = '';
            let headerHTML = '<tr><th rowspan="2">Направление / Заказчик</th>';
            periods.slice(0, -1).forEach(p => headerHTML += `<th colspan="2">${p.name}</th>`);
            headerHTML += `<th colspan="2">${periods[periods.length - 1].name}</th><th rowspan="2">Отклонение</th></tr><tr>`;
            periods.slice(0, -1).forEach(() => headerHTML += '<th>План</th><th>Факт</th>');
            headerHTML += '<th>План</th><th>Факт</th></tr>';
            thead.innerHTML = headerHTML;
            let grandTotalPlan = 0, grandTotalFact = 0;
            const sortedMethods = methods.sort((a, b) => {
                const indexA = methodOrder.indexOf(a.name), indexB = methodOrder.indexOf(b.name);
                if (indexA !== -1 && indexB !== -1) return indexA - indexB;
                if (indexA !== -1) return -1;
                if (indexB !== -1) return 1;
                return a.name.localeCompare(b.name);
            });
            sortedMethods.forEach((method) => {
                const sectionHeaderRow = document.createElement('tr');
                sectionHeaderRow.className = 'section-header';
                const methodTotalPercent = method.totalPlan > 0 ? Math.round((method.totalFact / method.totalPlan) * 100) : 0;
                const sectionSummary = `План: ${formatNumber(method.totalPlan / 1000)} | Факт: ${formatNumber(method.totalFact / 1000)} | ${methodTotalPercent}%`;
                sectionHeaderRow.innerHTML = `<td colspan="${periods.length * 2 + 1}">${method.name || 'Без направления'} <span class="section-summary">${sectionSummary}</span></td>`;
                tbody.appendChild(sectionHeaderRow);
                let methodTotalPlan = 0, methodTotalFact = 0, customerIndex = 0;
                method.customers.forEach(customer => {
                    const row = document.createElement('tr');
                    row.className = customerIndex % 2 === 0 ? 'zebra-even' : 'zebra-odd';
                    let rowHTML = `<td>${customer.name}</td>`;
                    periods.slice(0, -1).forEach(p => {
                        let periodKey = p.type === 'quarter' ? `${p.year}_Q${p.months[0]}` : `${p.year}_M${p.month}`;
                        const data = customer.periods[periodKey] || { plan: 0, fact: 0 };
                        const factClass = data.fact > data.plan ? 'highlight-red' : '';
                        rowHTML += `<td>${formatNumber(data.plan / 1000)}</td><td class="${factClass}">${formatNumber(data.fact / 1000)}</td>`;
                    });
                    rowHTML += `<td>${formatNumber(customer.totalPlan / 1000)}</td><td>${formatNumber(customer.totalFact / 1000)}</td>`;
                    const deviation = customer.totalPlan - customer.totalFact;
                    rowHTML += `<td class="${deviation < 0 ? 'highlight-red' : ''}">${formatNumber(deviation / 1000)}</td>`;
                    row.innerHTML = rowHTML;
                    tbody.appendChild(row);
                    methodTotalPlan += customer.totalPlan; methodTotalFact += customer.totalFact; customerIndex++;
                });
                const sectionTotalRow = document.createElement('tr');
                sectionTotalRow.className = 'section-total';
                let sectionTotalHTML = `<td>Итого по направлению</td>`;
                periods.slice(0, -1).forEach(p => {
                    let periodKey = p.type === 'quarter' ? `${p.year}_Q${p.months[0]}` : `${p.year}_M${p.month}`;
                    let periodPlan = 0, periodFact = 0;
                    method.customers.forEach(customer => {
                        const data = customer.periods[periodKey] || { plan: 0, fact: 0 };
                        periodPlan += data.plan; periodFact += data.fact;
                    });
                    const factClass = periodFact > periodPlan ? 'highlight-red' : '';
                    sectionTotalHTML += `<td>${formatNumber(periodPlan / 1000)}</td><td class="${factClass}">${formatNumber(periodFact / 1000)}</td>`;
                });
                sectionTotalHTML += `<td>${formatNumber(methodTotalPlan / 1000)}</td><td>${formatNumber(methodTotalFact / 1000)}</td>`;
                const sectionDeviation = methodTotalPlan - methodTotalFact;
                sectionTotalHTML += `<td class="${sectionDeviation < 0 ? 'highlight-red' : ''}">${formatNumber(sectionDeviation / 1000)}</td>`;
                sectionTotalRow.innerHTML = sectionTotalHTML;
                tbody.appendChild(sectionTotalRow);
                grandTotalPlan += methodTotalPlan; grandTotalFact += methodTotalFact;
            });
            const grandTotalRow = document.createElement('tr');
            grandTotalRow.className = 'grand-total';
            let grandTotalHTML = '<td>Итого по всем направлениям</td>';
            periods.slice(0, -1).forEach(() => grandTotalHTML += '<td>-</td><td>-</td>');
            grandTotalHTML += `<td>${formatNumber(grandTotalPlan / 1000)}</td><td>${formatNumber(grandTotalFact / 1000)}</td>`;
            const grandDeviation = grandTotalPlan - grandTotalFact;
            grandTotalHTML += `<td class="${grandDeviation < 0 ? 'highlight-red' : ''}">${formatNumber(grandDeviation / 1000)}</td>`;
            grandTotalRow.innerHTML = grandTotalHTML;
            tbody.appendChild(grandTotalRow);
        }

