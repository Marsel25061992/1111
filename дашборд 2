                renderDetailsTable(periods, methods);
                document.getElementById('loadingDetails').style.display = 'none';
                document.getElementById('infoBar').textContent = `✅ Загружено записей: ${rawData.length}, период: с ${monthNamesFull[dateRange.minDate.getMonth()]} по ${monthNamesFull[dateRange.maxDate.getMonth()]} ${dateRange.maxDate.getFullYear()} г., направлений: ${methods.length}`;
            }, 100);
        }

        // ===== НОВАЯ ЛОГИКА ПРОГНОЗА: ЧИСТО ПО ФАКТУ =====
        function updateForecastTab() {
            if (rawData.length === 0) return;

            let planByMonth = new Array(12).fill(0);
            let factByMonth = new Array(12).fill(0);
            let lastFactMonthIndex = -1;

            // 1. Собираем факт и план по месяцам
            rawData.forEach(d => {
                const m = d.month - 1;
                if (m >= 0 && m < 12) {
                    if (d.criteria === 'План') planByMonth[m] += d.costs;
                    else if (d.criteria === 'Факт') {
                        factByMonth[m] += d.costs;
                        if (d.costs > 0 && m > lastFactMonthIndex) {
                            lastFactMonthIndex = m;
                        }
                    }
                }
            });

            // 2. Определяем текущий неполный месяц
            const now = new Date();
            const currentMonthIdx = now.getMonth();
            const currentYear = now.getFullYear();
            
            // Находим год последнего факта, чтобы корректно сравнивать
            let lastFactYear = currentYear;
            rawData.forEach(d => {
                if (d.criteria === 'Факт' && d.costs > 0) {
                    if (d.year > lastFactYear) lastFactYear = d.year;
                }
            });

            let incompleteMonthIndex = -1;
            if (lastFactYear === currentYear && lastFactMonthIndex === currentMonthIdx) {
                incompleteMonthIndex = lastFactMonthIndex;
            }

            // 3. Формируем массив "чистого факта" выбранных месяцев для прогноза
            let selectedFacts = [];
            if (selectedForecastMonths.length === 0) {
                // По умолчанию: берем факт всех закрытых месяцев (где есть факт, и это не текущий неполный месяц)
                for (let i = 0; i <= lastFactMonthIndex; i++) {
                    if (factByMonth[i] > 0 && i !== incompleteMonthIndex) {
                        selectedFacts.push(factByMonth[i]);
                    }
                }
                // Если выбран только неполный месяц, берем его факт как базу
                if (selectedFacts.length === 0 && incompleteMonthIndex >= 0 && factByMonth[incompleteMonthIndex] > 0) {
                    selectedFacts.push(factByMonth[incompleteMonthIndex]);
                }
            } else {
                // Берем факт ТОЛЬКО тех месяцев, которые выбрал пользователь
                selectedForecastMonths.forEach(mNum => {
                    const idx = mNum - 1;
                    if (factByMonth[idx] > 0 && idx !== incompleteMonthIndex) {
                        selectedFacts.push(factByMonth[idx]);
                    }
                });
                // Если пользователь выбрал только неполный месяц
                if (selectedFacts.length === 0 && selectedForecastMonths.includes(incompleteMonthIndex + 1) && factByMonth[incompleteMonthIndex] > 0) {
                    selectedFacts.push(factByMonth[incompleteMonthIndex]);
                }
            }

            // 4. Рассчитываем базовое значение прогноза как среднее арифметическое чистого факта выбранных месяцев
            let baseFactForForecast = selectedFacts.length > 0 
                ? selectedFacts.reduce((a, b) => a + b, 0) / selectedFacts.length 
                : 0;

            let totalPlan = planByMonth.reduce((a, b) => a + b, 0);
            let totalFact = factByMonth.reduce((a, b) => a + b, 0);

            // 5. Формируем данные для графиков и таблицы
            let cumPlan = 0, cumFact = 0, cumForecast = 0;
            let dataCumPlan = [], dataCumFact = [], dataCumForecast = [];
            let dataMonthPlan = [], dataMonthFact = [], dataMonthForecast = [];
            
            let forecastStarted = false;

            for (let i = 0; i < 12; i++) {
                cumPlan += planByMonth[i];
                cumFact += factByMonth[i];

                let monthForecast = null;
                let isClosed = false;
                let isIncomplete = false;
                let isFuture = false;

                if (i < incompleteMonthIndex || (incompleteMonthIndex === -1 && i <= lastFactMonthIndex)) {
                    isClosed = true;
                    monthForecast = null; // Для закрытых месяцев прогноз не показываем
                } else if (i === incompleteMonthIndex) {
                    isIncomplete = true;
                    monthForecast = baseFactForForecast; // Для неполного месяца прогноз = базе из выбранного факта
                    forecastStarted = true;
                } else if (i > incompleteMonthIndex && (i > lastFactMonthIndex || incompleteMonthIndex === -1)) {
                    isFuture = true;
                    monthForecast = baseFactForForecast; // Для будущих месяцев прогноз = базе из выбранного факта
                    forecastStarted = true;
                }

                // Накопительный прогноз
                if (monthForecast !== null) {
                    if (isIncomplete) {
                        cumForecast = cumFact + monthForecast;
                    } else if (isFuture) {
                        cumForecast += monthForecast;
                    }
                } else {
                    cumForecast = cumFact;
                }

                dataCumPlan.push(cumPlan);
                dataCumFact.push(cumFact);
                dataCumForecast.push(forecastStarted ? cumForecast : null);
                
                dataMonthPlan.push(planByMonth[i]);
                dataMonthFact.push(factByMonth[i]);
                dataMonthForecast.push(monthForecast);
            }

            let finalForecast = cumForecast;
            
            document.getElementById('kpiTotalBudget').textContent = formatNumber(totalPlan / 1000) + ' тыс. руб';
            document.getElementById('kpiActual').textContent = formatNumber(totalFact / 1000) + ' тыс. руб';
            document.getElementById('kpiRemaining').textContent = formatNumber((totalPlan - totalFact) / 1000) + ' тыс. руб';
            document.getElementById('kpiForecast').textContent = formatNumber(finalForecast / 1000) + ' тыс. руб';

            // Накопительный график
            const ctxCum = document.getElementById('cumulativeForecastChart').getContext('2d');
            if (cumulativeChartInstance) cumulativeChartInstance.destroy();
            cumulativeChartInstance = new Chart(ctxCum, {
                type: 'line',
                data: {
                    labels: monthNames,
                    datasets: [
                        { label: 'План (накоп.)', data: dataCumPlan.map(v => v / 1000), borderColor: '#ffd700', backgroundColor: 'rgba(255, 215, 0, 0.1)', borderWidth: 2, tension: 0.3, fill: false },
                        { label: 'Факт (накоп.)', data: dataCumFact.map(v => v / 1000), borderColor: 'rgb(0, 180, 115)', backgroundColor: 'rgba(0, 180, 115, 0.1)', borderWidth: 3, tension: 0.3, fill: true, spanGaps: true },
                        { label: 'Прогноз (накоп.)', data: dataCumForecast.map(v => v === null ? null : v / 1000), borderColor: '#60a5fa', borderWidth: 3, borderDash: [8, 4], tension: 0.3, pointBackgroundColor: '#60a5fa', fill: false, spanGaps: false }
                    ]
                },
                options: {
                    responsive: true, maintainAspectRatio: false,
                    plugins: {
                        legend: { labels: { color: '#e0e0e0' } },
                        tooltip: { callbacks: { label: function(c) { return c.raw === null ? '' : c.dataset.label + ': ' + formatNumber(c.raw) + ' тыс. руб'; } } }
                    },
                    scales: { y: { ticks: { color: '#a0aec0', callback: v => formatNumber(v) }, grid: { color: '#2d3748' } }, x: { ticks: { color: '#a0aec0' }, grid: { color: '#2d3748' } } }
                }
            });

            // Гистограмма
            const ctxMonth = document.getElementById('monthlyForecastChart').getContext('2d');
            if (monthlyForecastChartInstance) monthlyForecastChartInstance.destroy();
            monthlyForecastChartInstance = new Chart(ctxMonth, {
                type: 'bar',
                data: {
                    labels: monthNames,
                    datasets: [
                        { label: 'План', data: dataMonthPlan.map(v => v / 1000), backgroundColor: 'rgba(255, 215, 0, 0.7)', borderColor: '#ffd700', borderWidth: 1 },
                        { label: 'Факт', data: dataMonthFact.map(v => v / 1000), backgroundColor: 'rgba(0, 180, 115, 0.7)', borderColor: 'rgb(0, 180, 115)', borderWidth: 1 },
                        { label: 'Прогноз', data: dataMonthForecast.map(v => v === null ? null : v / 1000), backgroundColor: 'rgba(96, 165, 250, 0.7)', borderColor: '#60a5fa', borderWidth: 1 }
                    ]
                },
                options: {
                    responsive: true, maintainAspectRatio: false,
                    plugins: {
                        legend: { labels: { color: '#e0e0e0' } },
                        tooltip: { callbacks: { label: function(c) { return c.raw === null ? '' : c.dataset.label + ': ' + formatNumber(c.raw) + ' тыс. руб'; } } }
                    },
                    scales: { y: { ticks: { color: '#a0aec0', callback: v => formatNumber(v) }, grid: { color: '#2d3748' } }, x: { ticks: { color: '#a0aec0' }, grid: { color: '#2d3748' } } }
                }
            });

            // Таблица
            const tbody = document.getElementById('forecastTableBody');
            tbody.innerHTML = '';
            cumPlan = 0; cumFact = 0; cumForecast = 0;
            for (let i = 0; i < 12; i++) {
                cumPlan += planByMonth[i];
                cumFact += factByMonth[i];
                
                let forecast = dataMonthForecast[i];
                let displayForecast = forecast !== null ? formatNumber(forecast / 1000) : '—';
                
                if (forecast !== null) cumForecast += forecast;
                else cumForecast = cumFact;
                
                let deviation = forecast !== null ? (cumForecast - cumPlan) : 0;
                let deviationClass = '';
                let deviationText = '—';
                
                if (forecast !== null) {
                    if (i === incompleteMonthIndex) {
                        deviationClass = 'forecast-partial';
                        deviationText = (deviation > 0 ? '+' : '') + formatNumber(deviation / 1000) + ' тыс. руб';
                    } else {
                        deviationClass = deviation > 0 ? 'forecast-overrun' : 'forecast-safe';
                        deviationText = (deviation > 0 ? '+' : '') + formatNumber(deviation / 1000) + ' тыс. руб';
                    }
                }

                let rowClass = (i === incompleteMonthIndex) ? 'forecast-partial' : '';

                tbody.innerHTML += `<tr class="${rowClass}">
                    <td>${monthNames[i]}</td>
                    <td>${formatNumber(planByMonth[i] / 1000)}</td>
                    <td>${formatNumber(factByMonth[i] / 1000)}</td>
                    <td>${displayForecast}</td>
                    <td>${formatNumber(cumPlan / 1000)}</td>
                    <td>${formatNumber(cumFact / 1000)}</td>
                    <td>${forecast !== null ? formatNumber(cumForecast / 1000) : '—'}</td>
                    <td class="${deviationClass}">${deviationText}</td>
                </tr>`;
            }
        }

        function showMessage(text, isError = false) {
            const messageDiv = document.getElementById('message');
            messageDiv.textContent = text;
            messageDiv.className = isError ? 'error-message' : 'success-message';
        }

        function initDashboard(dateRange) {
            updateAllCharts();
            initDepartmentsTab(dateRange);
            initDetailsTab(dateRange);
            updateForecastTab();
            document.getElementById('dashboardContent').style.display = 'block';
            document.getElementById('uploadSection').style.display = 'none';
        }

        document.getElementById('fileInput').addEventListener('change', function(e) {
            const file = e.target.files[0];
            if (!file) return;
            document.getElementById('fileName').textContent = 'Файл: ' + file.name;
            document.getElementById('loading').style.display = 'block';
            document.getElementById('loadingDetails').style.display = 'block';
            const reader = new FileReader();
            reader.onload = function(e) {
                try {
                    const data = new Uint8Array(e.target.result);
                    const workbook = XLSX.read(data, { type: 'array' });
                    const dateRange = processData(workbook);
                    processedData = { dateRange };
                    initDashboard(dateRange);
                } catch (error) {
                    console.error(error);
                    showMessage('Ошибка при загрузке файла: ' + error.message, true);
                    document.getElementById('loading').style.display = 'none';
                    document.getElementById('loadingDetails').style.display = 'none';
                }
            };
            reader.onerror = function() {
                showMessage('Ошибка при чтении файла', true);
                document.getElementById('loading').style.display = 'none';
                document.getElementById('loadingDetails').style.display = 'none';
            };
            reader.readAsArrayBuffer(file);
        });

        document.getElementById('exportButton').addEventListener('click', exportToExcel);
        document.getElementById('exportDetailsButton').addEventListener('click', exportDetailsToExcel);

        document.querySelectorAll('.tab').forEach(tab => {
            tab.addEventListener('click', function() {
                document.querySelectorAll('.tab').forEach(t => t.classList.remove('active'));
                document.querySelectorAll('.tab-content').forEach(c => c.classList.remove('active'));
                this.classList.add('active');
                document.getElementById(this.dataset.tab + 'Tab').classList.add('active');
            });
        });

        document.querySelectorAll('.filter-section .month-btn').forEach(btn => {
            btn.addEventListener('click', function() {
                document.querySelectorAll('.filter-section .month-btn').forEach(b => b.classList.remove('active'));
                this.classList.add('active');
                currentMonth = this.dataset.month;
                const statusText = currentMonth === 'all' ? 'все месяцы' : monthNames[parseInt(currentMonth) - 1];
                document.getElementById('filterStatusText').textContent = statusText;
                updateAllCharts();
            });
        });

        // Обработчик для МНОЖЕСТВЕННОГО выбора месяцев прогноза
        document.querySelectorAll('#forecastMonthSelector .month-btn').forEach(btn => {
            btn.addEventListener('click', function() {
                const monthVal = this.dataset.month;
                const allBtn = document.querySelector('#forecastMonthSelector .month-btn[data-month="all"]');
                
                if (monthVal === 'all') {
                    selectedForecastMonths = [];
                    document.querySelectorAll('#forecastMonthSelector .month-btn').forEach(b => b.classList.remove('active'));
                    this.classList.add('active');
                    document.getElementById('forecastBasisText').textContent = 'всех закрытых месяцев';
                } else {
                    allBtn.classList.remove('active');
                    const mNum = parseInt(monthVal);
                    const idx = selectedForecastMonths.indexOf(mNum);
                    
                    if (idx > -1) {
                        selectedForecastMonths.splice(idx, 1);
                        this.classList.remove('active');
                    } else {
                        selectedForecastMonths.push(mNum);
                        this.classList.add('active');
                    }
                    
                    if (selectedForecastMonths.length === 0) {
                        document.getElementById('forecastBasisText').textContent = 'всех закрытых месяцев';
                        allBtn.classList.add('active');
                    } else {
                        const names = selectedForecastMonths
                            .sort((a, b) => a - b)
                            .map(n => monthNames[n - 1])
                            .join(', ');
                        document.getElementById('forecastBasisText').textContent = names;
                    }
                }
                
                if (rawData.length > 0) {
                    updateForecastTab();
                }
            });
        });
    </script>
</body>
