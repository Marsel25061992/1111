                <div class="tab" data-tab="departments">Затраты по отделам</div>
                <div class="tab" data-tab="details">Детализация по разделам</div>
                <div class="tab" data-tab="forecast">Прогноз освоения</div>
            </div>

            <div class="filter-section">
                <div class="filter-title">📅 Фильтр по месяцам:</div>
                <div class="month-buttons">
                    <button class="month-btn active" data-month="all">Все</button>
                    <button class="month-btn" data-month="1">Янв</button>
                    <button class="month-btn" data-month="2">Фев</button>
                    <button class="month-btn" data-month="3">Мар</button>
                    <button class="month-btn" data-month="4">Апр</button>
                    <button class="month-btn" data-month="5">Май</button>
                    <button class="month-btn" data-month="6">Июн</button>
                    <button class="month-btn" data-month="7">Июл</button>
                    <button class="month-btn" data-month="8">Авг</button>
                    <button class="month-btn" data-month="9">Сен</button>
                    <button class="month-btn" data-month="10">Окт</button>
                    <button class="month-btn" data-month="11">Ноя</button>
                    <button class="month-btn" data-month="12">Дек</button>
                </div>
                <div class="filter-status">Показаны данные за: <span id="filterStatusText">все месяцы</span></div>
            </div>

            <div class="tab-content active" id="managerialTab">
                <div class="dashboard-grid">
                    <div class="card">
                        <div class="card-title">Освоение бюджета, тыс. руб</div>
                        <div class="donut-wrapper">
                            <canvas id="donutChart"></canvas>
                            <div class="donut-center" id="donutCenter">0%</div>
                        </div>
                        <div class="legend">
                            <div class="legend-item"><div class="legend-color" style="background: rgb(153, 153, 153);"></div><span>План</span></div>
                            <div class="legend-item"><div class="legend-color" style="background: rgb(0, 180, 115);"></div><span>Факт</span></div>
                        </div>
                    </div>
                    <div class="card">
                        <div class="card-title">По способу проведения, тыс. руб</div>
                        <div class="method-chart-wrapper"><canvas id="methodChart"></canvas></div>
                    </div>
                    <div class="card">
                        <div class="card-title">Освоение по месяцам, тыс. руб</div>
                        <div class="monthly-chart-wrapper"><canvas id="monthlyChart"></canvas></div>
                    </div>
                    <div class="card">
                        <div class="card-title">Детализация по заказчикам, тыс. руб</div>
                        <div class="table-container">
                            <table id="dataTable">
                                <thead><tr><th>Заказчик</th><th>План</th><th>Факт</th></tr></thead>
                                <tbody></tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>

            <div class="tab-content" id="departmentsTab">
                <div class="card">
                    <div class="card-title">Затраты по отделам, тыс. руб</div>
                    <div class="loading" id="loading"><div class="spinner"></div><div>Обработка данных...</div></div>
                    <div class="table-wrapper">
                        <table class="department-table" id="departmentTable"><thead></thead><tbody></tbody></table>
                    </div>
                    <div class="legend-box">🔴 <span>Красным выделены случаи, когда Факт превышает План</span></div>
                    <button class="export-button" id="exportButton">📥 Экспорт в Excel</button>
                </div>
            </div>

            <div class="tab-content" id="detailsTab">
                <div class="card">
                    <div class="card-title">Детализация по направлениям, тыс. руб</div>
                    <div class="loading" id="loadingDetails"><div class="spinner"></div><div>Обработка данных...</div></div>
                    <div class="info-bar" id="infoBar"></div>
                    <div class="table-wrapper">
                        <table class="details-table" id="detailsTable"><thead></thead><tbody></tbody></table>
                    </div>
                    <div class="legend-box">🔴 <span>Красным выделены случаи, когда Факт превышает План</span></div>
                    <button class="export-button" id="exportDetailsButton">📥 Экспорт в Excel</button>
                </div>
            </div>

            <div class="tab-content" id="forecastTab">
                <div class="info-bar">📊 Прогноз строится **исключительно на абсолютных значениях факта** выбранных вами месяцев. Никаких темпов и процентов.</div>
                
                <div class="dashboard-grid" style="grid-template-columns: repeat(4, 1fr); margin-bottom: 20px;">
                    <div class="card" style="text-align: center;">
                        <div style="font-size: 13px; color: #a0aec0; margin-bottom: 8px;">Всего бюджет</div>
                        <div id="kpiTotalBudget" style="font-size: 24px; font-weight: bold; color: #e0e0e0;">0 тыс. руб</div>
                    </div>
                    <div class="card" style="text-align: center;">
                        <div style="font-size: 13px; color: #a0aec0; margin-bottom: 8px;">Освоено (факт)</div>
                        <div id="kpiActual" style="font-size: 24px; font-weight: bold; color: rgb(0, 180, 115);">0 тыс. руб</div>
                    </div>
                    <div class="card" style="text-align: center;">
                        <div style="font-size: 13px; color: #a0aec0; margin-bottom: 8px;">Остаток</div>
                        <div id="kpiRemaining" style="font-size: 24px; font-weight: bold; color: #ffd700;">0 тыс. руб</div>
                    </div>
                    <div class="card" style="text-align: center;">
                        <div style="font-size: 13px; color: #a0aec0; margin-bottom: 8px;">Прогноз на конец года</div>
                        <div id="kpiForecast" style="font-size: 24px; font-weight: bold; color: #60a5fa;">0 тыс. руб</div>
                    </div>
                </div>

                <div class="card" style="margin-bottom: 20px;">
                    <div class="card-title">⚙️ База для прогноза: выберите месяцы, чистый факт которых будет использован для прогноза (можно несколько)</div>
                    <div class="filter-section" style="background: transparent; border: none; padding: 0;">
                        <div class="month-buttons" id="forecastMonthSelector">
                            <button class="month-btn active" data-month="all">Все закрытые</button>
                            <button class="month-btn" data-month="1">Янв</button>
                            <button class="month-btn" data-month="2">Фев</button>
                            <button class="month-btn" data-month="3">Мар</button>
                            <button class="month-btn" data-month="4">Апр</button>
                            <button class="month-btn" data-month="5">Май</button>
                            <button class="month-btn" data-month="6">Июн</button>
                            <button class="month-btn" data-month="7">Июл</button>
                            <button class="month-btn" data-month="8">Авг</button>
                            <button class="month-btn" data-month="9">Сен</button>
                            <button class="month-btn" data-month="10">Окт</button>
                            <button class="month-btn" data-month="11">Ноя</button>
                            <button class="month-btn" data-month="12">Дек</button>
                        </div>
                        <div class="filter-status">Используется факт месяцев: <span id="forecastBasisText">всех закрытых месяцев</span></div>
                    </div>
                </div>

                <div class="dashboard-grid">
                    <div class="card">
                        <div class="card-title">📈 Накопительный прогноз освоения</div>
                        <div class="monthly-chart-wrapper"><canvas id="cumulativeForecastChart"></canvas></div>
                    </div>
                    <div class="card">
                        <div class="card-title">📊 Помесячное освоение бюджета</div>
                        <div class="monthly-chart-wrapper"><canvas id="monthlyForecastChart"></canvas></div>
                    </div>
                </div>

                <div class="card">
                    <div class="card-title">📋 Детальный прогноз по месяцам</div>
                    <div class="table-wrapper">
                        <table class="details-table" id="forecastTable">
                            <thead>
                                <tr>
                                    <th>Месяц</th>
                                    <th>План (мес)</th>
                                    <th>Факт (мес)</th>
                                    <th>Прогноз (мес)</th>
                                    <th>План (накоп.)</th>
                                    <th>Факт (накоп.)</th>
                                    <th>Прогноз (накоп.)</th>
                                    <th>Отклонение</th>
                                </tr>
                            </thead>
                            <tbody id="forecastTableBody">
                                <tr><td colspan="8" class="no-data">Загрузите данные для расчета прогноза</td></tr>
                            </tbody>
                        </table>
                    </div>
                    <div class="legend-box" style="margin-top: 15px;">
                        🔵 <span style="color: #60a5fa;">Синим</span> выделен текущий неполный месяц (прогноз на весь месяц)<br>
                        🔴 <span>Красным</span> выделены превышения прогноза над планом
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script>
        Chart.register(ChartDataLabels);

        let rawData = [];
        let currentMonth = 'all';
        let donutChart, methodChart, monthlyChart;
        let processedData = null;
        
        let selectedForecastMonths = []; // массив номеров месяцев 1-12 для прогноза
        let cumulativeChartInstance = null;
        let monthlyForecastChartInstance = null;

        const monthNames = ['Янв', 'Фев', 'Мар', 'Апр', 'Май', 'Июн', 'Июл', 'Авг', 'Сен', 'Окт', 'Ноя', 'Дек'];
        const monthNamesFull = ['Январь', 'Февраль', 'Март', 'Апрель', 'Май', 'Июнь', 
                               'Июль', 'Август', 'Сентябрь', 'Октябрь', 'Ноябрь', 'Декабрь'];

        const methodOrder = ['Без бригадные ГИС','Бригадные ГИС','Работа с пластом','Добыча нефти мет.свабирования','Технологическое свабирование'];

        const customerMapping = [
            { pattern: /УГТМ\s*ОПиГСРС/i, name: 'УГТМ ОПиГСРС' },
            { pattern: /УГТМ\s*ОПиГСБС/i, name: 'УГТМ ОПиГСБС' },
            { pattern: /УГТМ\s*ОГРП/i, name: 'УГТМ ОГРП' },
            { pattern: /УГТМ\s*ОМУН/i, name: 'УГТМ ОМУН' },
            { pattern: /УГТМ\s*ООПЗП/i, name: 'УГТМ ООПЗП' },
            { pattern: /УДНГ\s*ОПТРС/i, name: 'УДНГ ОПТРС' },
            { pattern: /УДНГ\s*ОТиТДН/i, name: 'УДНГ ОТиТДН' },
            { pattern: /УДНГ\s*ОЭФС/i, name: 'УДНГ ОЭФС' },
            { pattern: /программа\s+исследовательских\s+работ/i, name: 'Программа исследовательских работ/мероприятий' },
            { pattern: /ОМРМИН/i, name: 'ОМРМИН' },
            { pattern: /ТатНИПИ/i, name: 'ТатНИПИ' },
            { pattern: /\bУРМ\b/i, name: 'УРМ' },
            { pattern: /\bООД\b/i, name: 'ООД' },
            { pattern: /\bГРР\b/i, name: 'ГРР' },
            { pattern: /прочие/i, name: 'Не распределенный объем' }
        ];

        function formatNumber(num) {
            if (num === null || num === undefined || isNaN(num)) return '0';
            return Math.round(num).toLocaleString('ru-RU');
        }

        function parseMonthFromDate(dateStr) {
            if (!dateStr) return null;
            if (typeof dateStr === 'string') {
                const parts = dateStr.split(/[\/.\-]/);
                if (parts.length === 3) {
                    const day = parseInt(parts[0]);
                    const month = parseInt(parts[1]);
                    const year = parseInt(parts[2]);
                    if (month >= 1 && month <= 12 && day >= 1 && day <= 31) {
                        return { month, year: year < 50 ? 2000 + year : 1900 + year };
                    }
                }
                const date = new Date(dateStr);
                if (!isNaN(date.getTime())) return { month: date.getMonth() + 1, year: date.getFullYear() };
            } else if (typeof dateStr === 'number') {
                const date = new Date(Math.round((dateStr - 25569) * 86400 * 1000));
                if (!isNaN(date.getTime())) return { month: date.getMonth() + 1, year: date.getFullYear() };
            } else if (dateStr instanceof Date) {
                return { month: dateStr.getMonth() + 1, year: dateStr.getFullYear() };
            }
            return null;
        }

        function normalizeCustomer(name) {
            if (!name) return 'Не распределенный объем';
            const str = String(name).trim();
            if (str === '') return 'Не распределенный объем';
            for (const mapping of customerMapping) if (mapping.pattern.test(str)) return mapping.name;
            return str;
        }

        function processData(workbook) {
            const worksheet = workbook.Sheets[workbook.SheetNames[0]];
            const data = XLSX.utils.sheet_to_json(worksheet, { header: 1, raw: true });
            if (data.length < 2) throw new Error('Файл не содержит данных');

            const headers = data[0].map(h => String(h || '').toLowerCase().trim());
            const colIndex = {
                customer: headers.findIndex(h => h.includes('заказчик')),
                method: headers.findIndex(h => h.includes('способ') || h.includes('проведения')),
                criteria: headers.findIndex(h => h.includes('критерий')),
                month: headers.findIndex(h => h.includes('месяц')),
                costs: headers.findIndex(h => h.includes('затраты'))
            };

            rawData = [];
            let minDate = null, maxDate = null;

            for (let i = 1; i < data.length; i++) {
                const row = data[i];
                if (!row || row.length === 0) continue;
                const rawCustomer = colIndex.customer >= 0 ? row[colIndex.customer] : '';
                const customer = normalizeCustomer(rawCustomer);
                const method = colIndex.method >= 0 ? String(row[colIndex.method] || '').trim() : '';
                const criteria = colIndex.criteria >= 0 ? String(row[colIndex.criteria] || '').trim() : '';
                const monthCell = colIndex.month >= 0 ? row[colIndex.month] : null;
                let costs = 0;
                if (colIndex.costs >= 0) {
                    const costVal = row[colIndex.costs];
                    if (typeof costVal === 'number') costs = costVal;
                    else if (typeof costVal === 'string') costs = parseFloat(costVal.replace(',', '.')) || 0;
                }
                const dateInfo = parseMonthFromDate(monthCell);
                const isPlan = criteria.toLowerCase().includes('план');
                const isFact = criteria.toLowerCase().includes('факт');
                if (!isPlan && !isFact) continue;
                if (!dateInfo) continue;
                const currentDate = new Date(dateInfo.year, dateInfo.month - 1);
                if (!minDate || currentDate < minDate) minDate = currentDate;
                if (!maxDate || currentDate > maxDate) maxDate = currentDate;
                rawData.push({ customer, method, criteria: isPlan ? 'План' : 'Факт', month: dateInfo.month, year: dateInfo.year, costs });
            }
            return { minDate, maxDate };
        }

        function getFilteredData() {
            if (currentMonth === 'all') return rawData;
            return rawData.filter(d => d.month.toString() === currentMonth);
        }

        function aggregateData(data) {
            const donut = { plan: 0, fact: 0 };
            const methodsMap = new Map(), monthlyMap = new Map(), customersMap = new Map();
            for (let i = 1; i <= 12; i++) monthlyMap.set(i, { plan: 0, fact: 0 });
            data.forEach(d => {
                if (d.criteria === 'План') donut.plan += d.costs; else donut.fact += d.costs;
                if (d.method) {
                    if (!methodsMap.has(d.method)) methodsMap.set(d.method, { plan: 0, fact: 0 });
                    const m = methodsMap.get(d.method);
                    if (d.criteria === 'План') m.plan += d.costs; else m.fact += d.costs;
                }
                if (monthlyMap.has(d.month)) {
                    const m = monthlyMap.get(d.month);
                    if (d.criteria === 'План') m.plan += d.costs; else m.fact += d.costs;
                }
                if (d.customer) {
                    if (!customersMap.has(d.customer)) customersMap.set(d.customer, { plan: 0, fact: 0 });
                    const c = customersMap.get(d.customer);
                    if (d.criteria === 'План') c.plan += d.costs; else c.fact += d.costs;
                }
            });
            return {
                donut,
                methods: Array.from(methodsMap.entries()).map(([name, data]) => ({ name, ...data })),
                monthly: Array.from(monthlyMap.entries()).sort((a, b) => a[0] - b[0]).map(([monthNum, data]) => ({ month: monthNames[monthNum - 1], monthNum, ...data })),
                customers: Array.from(customersMap.entries()).map(([name, data]) => ({ name, ...data }))
            };
        }

